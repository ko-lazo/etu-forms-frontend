{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "format": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "api:types": "openapi-typescript openapi.yaml -o app/api/schema.d.ts",
    "api:sync": "cp ../backend/docs/openapi.yaml openapi.yaml && npm run api:types"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.92",
    "@nuxt/ui": "^4.10.0",
    "nuxt": "^4.5.1",
    "qs": "^6.15.3",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@types/qs": "^6.15.1",
    "eslint": "^10.8.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
